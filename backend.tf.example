# Remote state for the root configuration.
#
# The state here describes shared infrastructure - the Harness project, the
# pipeline, the artifact bucket - so beyond a single operator it belongs in a
# remote backend with locking rather than in a local terraform.tfstate.
#
# The iacm/ configuration needs none of this: its state is stored and locked by
# the Harness IACM workspace.
#
# To adopt it:
#
#   1. Create the state bucket and lock table once, outside this stack:
#
#        aws s3api create-bucket --bucket my-tf-state --region us-east-1
#        aws s3api put-bucket-versioning --bucket my-tf-state \
#          --versioning-configuration Status=Enabled
#        aws dynamodb create-table --table-name my-tf-locks \
#          --attribute-definitions AttributeName=LockID,AttributeType=S \
#          --key-schema AttributeName=LockID,KeyType=HASH \
#          --billing-mode PAY_PER_REQUEST
#
#   2. Copy this file to backend.tf and fill in the names.
#   3. Run `tofu init -migrate-state` to move the existing local state across.

terraform {
  backend "s3" {
    bucket         = "REPLACE-ME-tf-state"
    key            = "lambda-service-setup/root.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "REPLACE-ME-tf-locks"
  }
}
