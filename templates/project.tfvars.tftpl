# DO NOT EDIT - generated by the root OpenTofu configuration (main.tf).
#
# This is the original project's copy of the same schema every self-service
# project's environments/*.tfvars file uses - see environments/demo-project.tfvars
# for a hand-written example, and iacm/variables.tf for the full schema.
#
# region, environment_name and manage_environment are deliberately not here:
# they're set directly on this project's workspace instead (harness.tf), the
# same way the environment-creation pipeline sets them on every self-service
# workspace it creates - a value living in this file would apply to every
# workspace that links it, which is only ever this one, but keeping the two
# mechanisms identical means there is exactly one way this works, not two.
#
# Regenerated on every root apply. Change the values in the root variables.tf
# instead of editing this file - the next apply overwrites it.

project_name = "${project_name}"

harness = {
  org_id              = "${harness_org_id}"
  project_id          = "${harness_project_id}"
  github_connector_id = "${github_connector_id}"
  github_branch       = "${github_branch}"
  aws_connector_id    = "${aws_connector_id}"
}

lambdas = {
  ${lambda_key} = {
    runtime               = "${runtime}"
    handler               = "${handler}"
    timeout               = ${timeout}
    memory_size           = ${memory_size}
    execution_role_arn    = "${execution_role_arn}"
    architecture          = "${architecture}"
    publish_version       = ${publish_version}
    environment_variables = ${environment_variables}

    artifact_by_region = {
      "${region}" = {
        bucket = "${artifact_bucket}"
        key    = "${artifact_key}"
      }
    }

    function_definition_path = "${function_definition_path}"

    # Pins this project's existing identifiers so migrating onto the shared
    # multi-lambda schema does not rename or recreate anything.
    function_name              = "${function_name}"
    service_identifier         = "${service_identifier}"
    artifact_source_identifier = "${artifact_source_identifier}"
  }
}

tags = {
%{ for key, value in tags ~}
  ${format("%-${tag_key_width}s", jsonencode(key))} = ${jsonencode(value)}
%{ endfor ~}
}
