# DO NOT EDIT - generated by the root OpenTofu configuration (main.tf).
#
# OpenTofu loads any *.auto.tfvars file in its working directory, so this is how
# the IACM stage receives its non-secret inputs. Editing it by hand is
# pointless: the next root apply overwrites it. Change the values in the root
# variables.tf instead.
#
# Credentials are deliberately absent - they reach the run as environment
# variables from the Harness credentials variable set.

aws_region = "${aws_region}"

function = {
  name                  = "${function_name}"
  runtime               = "${runtime}"
  handler               = "${handler}"
  timeout               = ${timeout}
  memory_size           = ${memory_size}
  architecture          = "${architecture}"
  publish_version       = ${publish_version}
  execution_role_arn    = "${execution_role_arn}"
  environment_variables = ${environment_variables}
}

# Only the function itself is built from a fixed location. The Harness service
# takes its artifact location as runtime inputs, supplied per execution by
# whichever stage published the package.
artifact = {
  bucket = "${artifact_bucket}"
  key    = "${artifact_key}"
}

harness = {
  org_id                     = "${harness_org_id}"
  project_id                 = "${harness_project_id}"
  github_connector_id        = "${github_connector_id}"
  github_branch              = "${github_branch}"
  function_definition_path   = "${function_definition_path}"
  service_identifier         = "${service_identifier}"
  artifact_source_identifier = "${artifact_source_identifier}"
}

tags = {
%{ for key, value in tags ~}
  ${jsonencode(key)} = ${jsonencode(value)}
%{ endfor ~}
}
