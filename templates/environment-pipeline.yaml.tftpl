pipeline:
  name: ${pipeline_name}
  identifier: ${pipeline_identifier}
  projectIdentifier: ${project_id}
  orgIdentifier: ${org_id}
  description: "Triggered by a push to dev/test/stage/prod that touches environments/**. Creates or updates one IACM workspace per (project, region) the pushed branch owns, then provisions every one of them via the Provision IACM Workspace pipeline."
  tags: {}
  properties:
    ci:
      codebase:
        connectorRef: ${github_connector_id}
        repoName: ${github_repo_name}
        build: <+input>
  stages:
    # -------------------------------------------------------------------------
    # 1. One workspace per (project file in environments/, region this branch
    #    owns). dev owns us-east-1 only; test/stage/prod own us-east-1 and
    #    us-west-1 - see the REGIONS case below.
    #
    #    Idempotent by design: every push re-syncs every project's workspaces
    #    for that branch, so a workspace's settings can never drift from this
    #    script even if it's touched outside the file that defines it.
    # -------------------------------------------------------------------------
    - stage:
        name: Create Workspaces
        identifier: create_workspaces
        description: "Creates or updates the IACM workspace for every environments/*.tfvars project, for every region this branch owns."
        type: CI
        spec:
          cloneCodebase: true
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: Run
                  name: Create or Update Workspaces
                  identifier: create_or_update_workspaces
                  timeout: ${step_timeout}
                  spec:
                    shell: Sh
                    image: ${ci_image}
                    command: |-
                      set -eu
                      apk add --no-cache curl jq >/dev/null

                      account_id="<+account.identifier>"
                      org_id="${org_id}"
                      project_id="${project_id}"
                      repo_url="${repo_url}"
                      github_connector="${github_connector_id}"
                      branch="<+codebase.branch>"
                      base="https://app.harness.io/gateway/iacm/api/orgs/$org_id/projects/$project_id/workspaces"

                      case "$branch" in
                        dev) regions="us-east-1" ;;
                        test|stage|prod) regions="us-east-1 us-west-1" ;;
                        *)
                          echo "Branch '$branch' owns no regions - nothing to do."
                          export WORKSPACE_IDS=""
                          exit 0
                          ;;
                      esac

                      workspace_ids=""

                      for f in environments/*.tfvars; do
                        [ -e "$f" ] || continue
                        project=$(basename "$f" .tfvars)

                        for region in $regions; do
                          project_key=$(echo "$project" | tr '-' '_')
                          region_key=$(echo "$region" | tr '-' '_')
                          ws_id="$project_key""_""$branch""_""$region_key"
                          varfile="environments/$project.tfvars"

                          echo "=== $project / $branch / $region -> workspace $ws_id ==="

                          body=$(jq -n \
                            --arg id "$ws_id" \
                            --arg name "$project ($branch/$region)" \
                            --arg desc "Self-service workspace for project '$project', environment '$branch', region '$region'. Managed by pushes to the '$branch' branch - do not edit by hand." \
                            --arg repo "$repo_url" \
                            --arg branch "$branch" \
                            --arg connector "$github_connector" \
                            --arg varfile "$varfile" \
                            --arg project "$project" \
                            --arg region "$region" \
                            '{
                              identifier: $id,
                              name: $name,
                              description: $desc,
                              provisioner: "opentofu",
                              provisioner_version: "latest",
                              cost_estimation_enabled: true,
                              repository: $repo,
                              repository_branch: $branch,
                              repository_connector: $connector,
                              repository_path: "iacm",
                              variable_sets: ["iacm_credentials"],
                              terraform_variables: {
                                project_name:     {key: "project_name",     value: $project, value_type: "string"},
                                region:           {key: "region",           value: $region,  value_type: "string"},
                                environment_name: {key: "environment_name", value: $branch,  value_type: "string"}
                              },
                              environment_variables: {},
                              terraform_variable_files: [
                                {repository: $repo, repository_branch: $branch, repository_connector: $connector, repository_path: $varfile}
                              ]
                            }')

                          status=$(curl -s -o /tmp/ws_get.json -w '%%{http_code}' \
                            "$base/$ws_id?accountIdentifier=$account_id" \
                            -H "x-api-key: $HARNESS_PLATFORM_API_KEY")

                          if [ "$status" = "200" ]; then
                            curl -sf -X PUT "$base/$ws_id?accountIdentifier=$account_id" \
                              -H "x-api-key: $HARNESS_PLATFORM_API_KEY" \
                              -H "Content-Type: application/json" \
                              -d "$body" > /tmp/ws_result.json
                            echo "updated workspace $ws_id"
                          elif [ "$status" = "404" ]; then
                            curl -sf -X POST "$base?accountIdentifier=$account_id" \
                              -H "x-api-key: $HARNESS_PLATFORM_API_KEY" \
                              -H "Content-Type: application/json" \
                              -d "$body" > /tmp/ws_result.json
                            echo "created workspace $ws_id"
                          else
                            echo "FAIL: unexpected status $status checking workspace $ws_id"
                            cat /tmp/ws_get.json
                            exit 1
                          fi

                          workspace_ids="$workspace_ids $ws_id"
                        done
                      done

                      export WORKSPACE_IDS=$(echo "$workspace_ids" | xargs)
                      echo "Workspaces for this run: $WORKSPACE_IDS"
                    envVariables:
                      HARNESS_PLATFORM_API_KEY: <+secrets.getValue("${harness_pat_secret}")>
                    outputVariables:
                      - name: WORKSPACE_IDS
        tags: {}

    # -------------------------------------------------------------------------
    # 2. Run init/plan/apply against every workspace the previous stage
    #    touched, by triggering the generic Provision IACM Workspace pipeline
    #    once per workspace id and waiting for each to finish.
    # -------------------------------------------------------------------------
    - stage:
        name: Provision Workspaces
        identifier: provision_workspaces
        description: "Runs init/plan/apply against every workspace Create Workspaces touched."
        type: CI
        spec:
          cloneCodebase: false
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: Run
                  name: Provision Workspaces
                  identifier: run_provision_workspaces
                  timeout: ${provision_timeout}
                  spec:
                    shell: Sh
                    image: ${ci_image}
                    command: |-
                      set -eu
                      apk add --no-cache curl jq >/dev/null

                      account_id="<+account.identifier>"
                      org_id="${org_id}"
                      project_id="${project_id}"
                      workspace_ids="<+pipeline.stages.create_workspaces.spec.execution.steps.create_or_update_workspaces.output.outputVariables.WORKSPACE_IDS>"

                      if [ -z "$workspace_ids" ]; then
                        echo "No workspaces to provision."
                        exit 0
                      fi

                      overall_status=0

                      for ws in $workspace_ids; do
                        echo "=== Provisioning $ws ==="

                        run_inputs=$(printf 'pipeline:\n  identifier: %s\n  variables:\n    - name: workspace_id\n      type: String\n      value: %s\n' \
                          "${provision_pipeline_id}" "$ws")

                        exec_id=$(curl -sf -X POST \
                          "https://app.harness.io/gateway/pipeline/api/pipeline/execute/${provision_pipeline_id}?accountIdentifier=$account_id&orgIdentifier=$org_id&projectIdentifier=$project_id" \
                          -H "x-api-key: $HARNESS_PLATFORM_API_KEY" \
                          -H "Content-Type: application/yaml" \
                          --data-binary "$run_inputs" \
                          | jq -r '.data.planExecution.uuid // empty')

                        if [ -z "$exec_id" ]; then
                          echo "FAIL: could not start provisioning for $ws"
                          overall_status=1
                          continue
                        fi

                        status="Running"
                        attempts=0
                        while true; do
                          case "$status" in
                            Running|Queued|Waiting|AsyncWaiting|NotStarted|WaitStepRunning) ;;
                            *) break ;;
                          esac

                          attempts=$((attempts + 1))
                          if [ "$attempts" -gt ${provision_poll_attempts} ]; then
                            echo "FAIL: $ws timed out waiting for provisioning"
                            status="Timeout"
                            break
                          fi

                          sleep ${provision_poll_interval}
                          status=$(curl -sf \
                            "https://app.harness.io/gateway/pipeline/api/pipelines/execution/v2/$exec_id?accountIdentifier=$account_id&orgIdentifier=$org_id&projectIdentifier=$project_id" \
                            -H "x-api-key: $HARNESS_PLATFORM_API_KEY" \
                            | jq -r '.data.pipelineExecutionSummary.status // "Unknown"')
                        done

                        echo "$ws finished with status: $status"
                        if [ "$status" != "Success" ]; then
                          overall_status=1
                        fi
                      done

                      if [ "$overall_status" -ne 0 ]; then
                        echo "One or more workspaces failed to provision."
                        exit 1
                      fi

                      echo "All workspaces provisioned successfully."
                    envVariables:
                      HARNESS_PLATFORM_API_KEY: <+secrets.getValue("${harness_pat_secret}")>
        tags: {}
