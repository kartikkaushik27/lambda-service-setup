pipeline:
  name: ${pipeline_name}
  identifier: ${pipeline_identifier}
  projectIdentifier: ${project_id}
  orgIdentifier: ${org_id}
  description: "Runs init/plan/apply against whichever IACM workspace it's given. Generic on purpose: the environment-creation pipeline calls this once per (project, region) workspace it creates - see environment_pipeline.tf."
  tags: {}
  variables:
    - name: workspace_id
      type: String
      description: Identifier of the IACM workspace to provision. Supplied by whoever triggers this pipeline.
      value: <+input>
  stages:
    - stage:
        name: Provision
        identifier: provision
        description: "init, plan, apply against <+pipeline.variables.workspace_id>."
        type: IACM
        spec:
          workspace: <+pipeline.variables.workspace_id>
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: IACMTerraformPlugin
                  name: init
                  identifier: init
                  timeout: ${step_timeout}
                  spec:
                    command: init
              - step:
                  type: IACMTerraformPlugin
                  name: plan
                  identifier: plan
                  timeout: ${step_timeout}
                  spec:
                    command: plan
              - step:
                  type: IACMTerraformPlugin
                  name: apply
                  identifier: apply
                  timeout: ${step_timeout}
                  spec:
                    command: apply
        tags: {}
