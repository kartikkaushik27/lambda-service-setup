pipeline:
  name: ${pipeline_name}
  identifier: ${pipeline_identifier}
  projectIdentifier: ${project_id}
  orgIdentifier: ${org_id}
  description: "Triggered by a push to dev/test/stage/prod. Detects which lambdas changed (or were never deployed), builds and publishes only those artifacts in parallel, creates or updates one IACM workspace per (project, region) the branch owns, applies every one of them, deploys only the changed lambdas with the native AWS Lambda deploy step, then verifies each. Change detection, artifact publishing, and workspace creation are scripted (no native step for any); every other stage uses native Harness steps, run once per item via a looping strategy."
  tags: {}
  properties:
    ci:
      codebase:
        connectorRef: ${github_connector_id}
        repoName: ${github_repo_name}
        build: <+input>
  stages:
    # -------------------------------------------------------------------
    # 1. Find which (project, lambda, region) artifacts actually need a new
    #    build: source changed since the last commit, or the function has
    #    never been deployed yet. Everything else is left untouched - this
    #    is what keeps an N-lambda project from redeploying all N whenever
    #    only some of them change.
    # -------------------------------------------------------------------
    - stage:
        name: Detect Changed Artifacts
        identifier: detect_changes
        description: "Finds which lambda-src/<project>/<lambda> directories changed in the last push, or have never been deployed, for every region this branch owns."
        type: CI
        spec:
          cloneCodebase: true
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: Run
                  name: Detect Changed Artifacts
                  identifier: detect_changes
                  timeout: ${workspace_step_timeout}
                  spec:
                    shell: Sh
                    image: ${ci_image}
                    command: |-
                      set -eu
                      apk add --no-cache git aws-cli jq python3 >/dev/null

                      branch="<+codebase.branch>"
                      case "$branch" in
                        dev) regions="us-east-1" ;;
                        test|stage|prod) regions="us-east-1 us-west-1" ;;
                        *) echo "Branch '$branch' owns no regions - nothing to build."; export BUILD_ITEMS=""; exit 0 ;;
                      esac

                      git fetch --quiet --unshallow 2>/dev/null || git fetch --quiet --depth=2 origin "$branch" 2>/dev/null || true
                      if git rev-parse HEAD~1 >/dev/null 2>&1; then
                        changed_files=$(git diff --name-only HEAD~1 HEAD)
                      else
                        changed_files=$(git ls-files)
                      fi

                      build_items=""

                      for f in environments/*.tfvars; do
                        [ -e "$f" ] || continue
                        project=$(basename "$f" .tfvars)

                        # The original project is pinned to its own dedicated
                        # pipeline/workspace (pipeline.tf, harness.tf) and
                        # already owns the AWS Lambda function named here -
                        # this self-service flow must not also manage it.
                        [ "$project" = "${legacy_project_name}" ] && continue

                        for region in $regions; do
                          parsed=$(python3 scripts/parse_lambdas.py "$f" "$region")
                          echo "$parsed" | jq -c '.lambdas[]' > /tmp/detect_lambdas.ndjson

                          while IFS= read -r lam; do
                            key=$(echo "$lam" | jq -r '.key')
                            function_name=$(echo "$lam" | jq -r '.function_name // empty')
                            [ -n "$function_name" ] || function_name="$project-$key-$branch"
                            src="lambda-src/$project/$key"

                            if [ ! -d "$src" ]; then
                              echo "SKIP: no source at $src for $project/$key - assuming its artifact is published elsewhere."
                              continue
                            fi

                            reason=""
                            if echo "$changed_files" | grep -q "^$src/"; then
                              reason="source changed"
                            elif ! aws lambda get-function --function-name "$function_name" --region "$region" >/dev/null 2>&1; then
                              reason="not deployed yet"
                            fi

                            if [ -n "$reason" ]; then
                              echo "BUILD: $project/$key in $region ($reason)"
                              build_items="$${build_items:+$build_items,}$project~$key~$region"
                            else
                              echo "SKIP: $project/$key in $region unchanged"
                            fi
                          done < /tmp/detect_lambdas.ndjson
                        done
                      done

                      export BUILD_ITEMS="$build_items"
                      echo "build items: $BUILD_ITEMS"
                    envVariables:
                      AWS_ACCESS_KEY_ID: <+secrets.getValue("${aws_access_key_id_secret}")>
                      AWS_SECRET_ACCESS_KEY: <+secrets.getValue("${aws_secret_access_key_secret}")>
                      AWS_SESSION_TOKEN: <+secrets.getValue("${aws_session_token_secret}")>
                    outputVariables:
                      - name: BUILD_ITEMS
        tags: {}

    # -------------------------------------------------------------------
    # 2. Build and publish only the artifacts Detect Changed Artifacts
    #    flagged, one matrix cell per (project, lambda, region), running in
    #    parallel.
    # -------------------------------------------------------------------
    - stage:
        name: Build Artifacts
        identifier: build_artifacts
        description: "Zips and publishes <+matrix.item> to the S3 location its environments/*.tfvars declares."
        type: CI
        when:
          pipelineStatus: Success
          condition: <+pipeline.stages.detect_changes.spec.execution.steps.detect_changes.output.outputVariables.BUILD_ITEMS> != ""
        strategy:
          matrix:
            item: <+pipeline.stages.detect_changes.spec.execution.steps.detect_changes.output.outputVariables.BUILD_ITEMS.split(",")>
            maxConcurrency: ${max_concurrency}
        spec:
          cloneCodebase: true
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: Run
                  name: Build and Publish Artifact
                  identifier: build_and_publish_artifact
                  timeout: ${workspace_step_timeout}
                  spec:
                    shell: Sh
                    image: ${ci_image}
                    command: |-
                      set -eu
                      apk add --no-cache zip aws-cli jq python3 >/dev/null

                      # <+matrix.item> is one "project~lambda~region" entry from
                      # BUILD_ITEMS (Detect Changed Artifacts).
                      item="<+matrix.item>"
                      project=$(echo "$item" | cut -d'~' -f1)
                      key=$(echo "$item" | cut -d'~' -f2)
                      region=$(echo "$item" | cut -d'~' -f3)

                      parsed=$(python3 scripts/parse_lambdas.py "environments/$project.tfvars" "$region")
                      lam=$(echo "$parsed" | jq -c --arg k "$key" '.lambdas[] | select(.key == $k)')
                      bucket=$(echo "$lam" | jq -r '.bucket')
                      object_key=$(echo "$lam" | jq -r '.object_key')
                      src="lambda-src/$project/$key"

                      echo "=== Building $project/$key for $region -> s3://$bucket/$object_key ==="
                      pkg="/tmp/$project-$key.zip"
                      rm -f "$pkg"
                      (cd "$src" && zip -r -q "$pkg" .)
                      aws s3 cp "$pkg" "s3://$bucket/$object_key" --region "$region"
                    envVariables:
                      AWS_ACCESS_KEY_ID: <+secrets.getValue("${aws_access_key_id_secret}")>
                      AWS_SECRET_ACCESS_KEY: <+secrets.getValue("${aws_secret_access_key_secret}")>
                      AWS_SESSION_TOKEN: <+secrets.getValue("${aws_session_token_secret}")>
        tags: {}

    # -------------------------------------------------------------------
    # 3. Create/update the IACM workspace for every environments/*.tfvars
    #    project, for every region the triggering branch owns, and export
    #    two lists for the looping strategies below:
    #      WORKSPACE_IDS  - one entry per (project, region)
    #      DEPLOY_ITEMS   - one entry per (project, lambda, region), with
    #                       the exact service/environment/infra identifiers
    #                       iacm/main.tf creates for it.
    # -------------------------------------------------------------------
    - stage:
        name: Create Workspaces
        identifier: create_workspaces
        description: "Creates or updates the IACM workspace for every environments/*.tfvars project, for every region this branch owns. The only scripted step - IACM has no native step for creating a workspace."
        type: CI
        spec:
          cloneCodebase: true
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: Run
                  name: Create or Update Workspaces
                  identifier: create_or_update_workspaces
                  timeout: ${workspace_step_timeout}
                  spec:
                    shell: Sh
                    image: ${ci_image}
                    command: |-
                      set -eu
                      apk add --no-cache curl jq python3 >/dev/null

                      # Harness omits the env var entirely (rather than exporting
                      # an empty string) when an upstream output expression
                      # resolves to "" - under `set -u` that makes a bare
                      # $BUILD_ITEMS reference below fail with "parameter not
                      # set" even though "nothing to build" is a valid outcome.
                      BUILD_ITEMS="$${BUILD_ITEMS:-}"

                      account_id="<+account.identifier>"
                      org_id="${org_id}"
                      project_id="${project_id}"
                      repo_url="${repo_url}"
                      github_connector="${github_connector_id}"
                      branch="<+codebase.branch>"
                      base="https://app.harness.io/gateway/iacm/api/orgs/$org_id/projects/$project_id/workspaces"

                      case "$branch" in
                        dev) regions="us-east-1" ;;
                        test|stage|prod) regions="us-east-1 us-west-1" ;;
                        *)
                          echo "Branch '$branch' owns no regions - nothing to do."
                          export WORKSPACE_IDS=""
                          export DEPLOY_ITEMS=""
                          exit 0
                          ;;
                      esac

                      # Looping strategies only accept a comma-separated list of
                      # plain strings (Harness has no native support for looping
                      # over JSON), so both lists below are built as such: a
                      # bare comma-joined list of workspace ids, and a
                      # comma-joined list of "~"-delimited per-lambda records
                      # that later stages re-split field by field - see
                      # <+repeat.item.split("~")[N]> in the stages below.
                      workspace_ids=""
                      deploy_items=""

                      for f in environments/*.tfvars; do
                        [ -e "$f" ] || continue
                        project=$(basename "$f" .tfvars)

                        # See the matching skip in the Build Artifacts stage.
                        [ "$project" = "${legacy_project_name}" ] && continue

                        project_key=$(echo "$project" | tr '-' '_')

                        # The Harness environment is shared by every region this
                        # project/branch deploys to, but each region is a
                        # separate workspace with a separate Terraform state -
                        # only the first region below may create it (Create
                        # Lambda and Service runs with maxConcurrency 1, in
                        # $regions order, so it always finishes owning the
                        # environment before any other region starts). Every
                        # region always creates its own infrastructure
                        # definition (iacm/main.tf manage_infrastructure default).
                        is_first_region=true
                        for region in $regions; do
                          region_key=$(echo "$region" | tr '-' '_')
                          ws_id="$project-$branch-$region"

                          echo "=== $project / $branch / $region -> workspace $ws_id ==="

                          body=$(jq -n \
                            --arg id "$ws_id" --arg repo "$repo_url" --arg branch "$branch" \
                            --arg connector "$github_connector" --arg varfile "$f" \
                            --arg project "$project" --arg region "$region" \
                            --arg manage_env "$is_first_region" \
                            '{
                              identifier: $id, name: $id, provisioner: "opentofu",
                              provisioner_version: "latest", provider_connector: "",
                              cost_estimation_enabled: true,
                              repository: $repo, repository_branch: $branch,
                              repository_connector: $connector, repository_path: "iacm",
                              variable_sets: ["${credentials_variable_set}"],
                              terraform_variables: {
                                project_name:      {key: "project_name",      value: $project,   value_type: "string"},
                                region:            {key: "region",            value: $region,    value_type: "string"},
                                environment_name:  {key: "environment_name",  value: $branch,    value_type: "string"},
                                manage_environment: {key: "manage_environment", value: $manage_env, value_type: "string"}
                              },
                              environment_variables: {},
                              terraform_variable_files: [
                                {repository: $repo, repository_branch: $branch, repository_connector: $connector, repository_path: $varfile}
                              ]
                            }')
                          is_first_region=false

                          status=$(curl -s -o /tmp/ws_get.json -w '%%{http_code}' \
                            "$base/$ws_id?accountIdentifier=$account_id" \
                            -H "x-api-key: $HARNESS_PLATFORM_API_KEY")

                          if [ "$status" = "200" ]; then
                            curl -sf -X PUT "$base/$ws_id?accountIdentifier=$account_id" \
                              -H "x-api-key: $HARNESS_PLATFORM_API_KEY" -H "Content-Type: application/json" \
                              -d "$body" >/dev/null
                            echo "updated workspace $ws_id"
                          elif [ "$status" = "404" ]; then
                            curl -sf -X POST "$base?accountIdentifier=$account_id" \
                              -H "x-api-key: $HARNESS_PLATFORM_API_KEY" -H "Content-Type: application/json" \
                              -d "$body" >/dev/null
                            echo "created workspace $ws_id"
                          else
                            echo "FAIL: unexpected status $status checking workspace $ws_id"
                            cat /tmp/ws_get.json
                            exit 1
                          fi

                          workspace_ids="$${workspace_ids:+$workspace_ids,}$ws_id"

                          parsed=$(python3 scripts/parse_lambdas.py "$f" "$region")
                          aws_connector=$(echo "$parsed" | jq -r '.aws_connector_id')
                          echo "$parsed" | jq -c '.lambdas[]' > /tmp/lambdas.ndjson

                          while IFS= read -r lam; do
                            key=$(echo "$lam" | jq -r '.key')
                            function_name=$(echo "$lam" | jq -r '.function_name // empty')
                            service_id=$(echo "$lam" | jq -r '.service_identifier // empty')
                            artifact_source_id=$(echo "$lam" | jq -r '.artifact_source_identifier // empty')
                            bucket=$(echo "$lam" | jq -r '.bucket')
                            object_key=$(echo "$lam" | jq -r '.object_key')

                            [ -n "$function_name" ] || function_name="$project-$key-$branch"
                            [ -n "$service_id" ] || service_id="$${project_key}_$${key}_$${branch}_$${region_key}"
                            [ -n "$artifact_source_id" ] || artifact_source_id="$${project_key}_$${key}_artifact"

                            environment_id="$${project_key}_$branch"
                            infra_id="$${environment_id}_$region_key"

                            # Only deploy lambdas Detect Changed Artifacts actually
                            # rebuilt this run - everything else keeps running
                            # whatever code is already on it.
                            match_key="$project~$key~$region"
                            case ",$BUILD_ITEMS," in
                              *",$match_key,"*)
                                item="$environment_id~$infra_id~$service_id~$artifact_source_id~$function_name~$aws_connector~$region~$bucket~$object_key"
                                deploy_items="$${deploy_items:+$deploy_items,}$item"
                                ;;
                              *)
                                echo "SKIP deploy for $match_key - not rebuilt this run"
                                ;;
                            esac
                          done < /tmp/lambdas.ndjson
                        done
                      done

                      export WORKSPACE_IDS="$workspace_ids"
                      export DEPLOY_ITEMS="$deploy_items"
                      echo "workspaces: $WORKSPACE_IDS"
                      echo "deploy items: $DEPLOY_ITEMS"
                    envVariables:
                      HARNESS_PLATFORM_API_KEY: <+secrets.getValue("${harness_pat_secret}")>
                      BUILD_ITEMS: <+pipeline.stages.detect_changes.spec.execution.steps.detect_changes.output.outputVariables.BUILD_ITEMS>
                    outputVariables:
                      - name: WORKSPACE_IDS
                      - name: DEPLOY_ITEMS
        tags: {}

    # -------------------------------------------------------------------
    # 4. init/plan/apply against every workspace stage 3 touched - native
    #    IACMTerraformPlugin steps, run once per workspace via a repeat
    #    looping strategy over WORKSPACE_IDS.
    # -------------------------------------------------------------------
    - stage:
        name: Create Lambda and Service
        identifier: create_lambda_and_service
        description: "Runs init/plan/apply against <+repeat.item>, one iteration per workspace Create Workspaces touched. Sequential (maxConcurrency 1): the first region's workspace for each project owns the shared Harness environment, so it must finish before any other region's workspace runs."
        type: IACM
        strategy:
          repeat:
            items: <+pipeline.stages.create_workspaces.spec.execution.steps.create_or_update_workspaces.output.outputVariables.WORKSPACE_IDS.split(",")>
            maxConcurrency: ${iacm_max_concurrency}
        spec:
          workspace: <+repeat.item>
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: IACMTerraformPlugin
                  name: init
                  identifier: init
                  timeout: ${iacm_step_timeout}
                  spec:
                    command: init
              - step:
                  type: IACMTerraformPlugin
                  name: plan
                  identifier: plan
                  timeout: ${iacm_step_timeout}
                  spec:
                    command: plan
              - step:
                  type: IACMTerraformPlugin
                  name: apply
                  identifier: apply
                  timeout: ${iacm_step_timeout}
                  spec:
                    command: apply
        tags: {}

    # -------------------------------------------------------------------
    # 5. Deploy every changed lambda with the native AwsLambdaDeploy step, against
    #    the service/environment/infra Terraform just created for it - one
    #    iteration per DEPLOY_ITEMS entry via a repeat looping strategy.
    # -------------------------------------------------------------------
    - stage:
        name: Deploy Lambdas
        identifier: deploy_lambdas
        # DEPLOY_ITEMS is a comma-separated list of "~"-delimited records:
        #   0 environment  1 infra  2 service  3 artifact_source
        #   4 function_name  5 artifact_connector  6 artifact_region
        #   7 artifact_bucket  8 artifact_key
        # (built by the Create Workspaces stage - see the comment above WORKSPACE_IDS there).
        description: "Deploys <+repeat.item.split(\"~\")[4]> with the native AWS Lambda deploy step, one iteration per lambda Detect Changed Artifacts rebuilt."
        type: Deployment
        when:
          pipelineStatus: Success
          condition: <+pipeline.stages.create_workspaces.spec.execution.steps.create_or_update_workspaces.output.outputVariables.DEPLOY_ITEMS> != ""
        strategy:
          repeat:
            items: <+pipeline.stages.create_workspaces.spec.execution.steps.create_or_update_workspaces.output.outputVariables.DEPLOY_ITEMS.split(",")>
            maxConcurrency: ${deploy_max_concurrency}
        variables:
          # The committed function-definition.json references this plain
          # variable instead of embedding <+repeat.item.split(...)> directly -
          # raw text substitution inside a git-fetched manifest does not
          # reliably evaluate JEXL method calls like .split(), which was
          # silently resolving functionName to the literal string "null".
          - name: function_name
            type: String
            value: <+repeat.item.split("~")[4]>
        spec:
          deploymentType: AwsLambda
          service:
            serviceRef: <+repeat.item.split("~")[2]>
            serviceInputs:
              serviceDefinition:
                type: AwsLambda
                spec:
                  artifacts:
                    primary:
                      primaryArtifactRef: <+repeat.item.split("~")[3]>
                      sources:
                        - identifier: <+repeat.item.split("~")[3]>
                          type: AmazonS3
                          spec:
                            connectorRef: <+repeat.item.split("~")[5]>
                            region: <+repeat.item.split("~")[6]>
                            bucketName: <+repeat.item.split("~")[7]>
                            filePath: <+repeat.item.split("~")[8]>
          environment:
            environmentRef: <+repeat.item.split("~")[0]>
            infrastructureDefinitions:
              - identifier: <+repeat.item.split("~")[1]>
          execution:
            steps:
              - step:
                  type: AwsLambdaDeploy
                  name: AWS Lambda Deploy
                  identifier: aws_lambda_deploy
                  timeout: ${iacm_step_timeout}
                  spec: {}
            rollbackSteps:
              - step:
                  type: AwsLambdaRollback
                  name: AWS Lambda Rollback
                  identifier: aws_lambda_rollback
                  timeout: ${iacm_step_timeout}
                  spec: {}
        failureStrategies:
          - onFailure:
              errors:
                - AllErrors
              action:
                type: StageRollback
        tags: {}

    # -------------------------------------------------------------------
    # 6. Prove every deployment works by invoking the function and
    #    asserting on its response - one iteration per DEPLOY_ITEMS entry.
    # -------------------------------------------------------------------
    - stage:
        name: Validate Lambdas
        identifier: validate_lambdas
        description: "Invokes <+repeat.item.split(\"~\")[4]> and fails unless it responds successfully."
        type: CI
        when:
          pipelineStatus: Success
          condition: <+pipeline.stages.create_workspaces.spec.execution.steps.create_or_update_workspaces.output.outputVariables.DEPLOY_ITEMS> != ""
        strategy:
          repeat:
            items: <+pipeline.stages.create_workspaces.spec.execution.steps.create_or_update_workspaces.output.outputVariables.DEPLOY_ITEMS.split(",")>
            maxConcurrency: ${max_concurrency}
        spec:
          cloneCodebase: false
          platform:
            os: Linux
            arch: Amd64
          runtime:
            type: Cloud
            spec: {}
          execution:
            steps:
              - step:
                  type: Run
                  name: Invoke and Assert
                  identifier: invoke_and_assert
                  timeout: ${iacm_step_timeout}
                  spec:
                    shell: Sh
                    image: ${ci_image}
                    command: |-
                      set -eu
                      apk add --no-cache aws-cli >/dev/null

                      aws lambda invoke \
                        --function-name "<+repeat.item.split("~")[4]>" \
                        --region "<+repeat.item.split("~")[6]>" \
                        --payload '{}' \
                        --cli-binary-format raw-in-base64-out \
                        /tmp/response.json > /tmp/invoke-meta.json

                      echo "---- invocation metadata ----"
                      cat /tmp/invoke-meta.json
                      echo ""
                      echo "---- response payload ----"
                      cat /tmp/response.json
                      echo ""

                      if grep -q '"FunctionError"' /tmp/invoke-meta.json; then
                        echo "FAIL: the function returned an error"
                        exit 1
                      fi

                      if grep -Eq '"statusCode":[[:space:]]*200' /tmp/response.json; then
                        echo "PASS: <+repeat.item.split("~")[4]> responded with statusCode 200"
                      else
                        echo "FAIL: unexpected response payload"
                        exit 1
                      fi
                    envVariables:
                      AWS_ACCESS_KEY_ID: <+secrets.getValue("${aws_access_key_id_secret}")>
                      AWS_SECRET_ACCESS_KEY: <+secrets.getValue("${aws_secret_access_key_secret}")>
                      AWS_SESSION_TOKEN: <+secrets.getValue("${aws_session_token_secret}")>
        tags: {}
